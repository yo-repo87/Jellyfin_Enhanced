+        const setEasyPin = (pin: string) => {
+            if (!api || !user.Id) {
+                console.error('[UserPasswordForm.setEasyPin] missing api or user id');
+                return;
+            }
+
+            loading.show();
+            const authHeader = getAuthorizationHeader(api.clientInfo, api.deviceInfo, api.accessToken);
+            api.axiosInstance.post(
+                api.getUri(`/Users/${user.Id}/EasyPassword`),
+                pin ? { NewPw: pin } : { ResetPassword: true },
+                { headers: { Authorization: authHeader } }
+            ).then(() => {
+                // The pin only works in-network when EnableLocalPassword is on
+                if (!user.Configuration) {
+                    return Promise.resolve();
+                }
+                return getUserApi(api).updateUserConfiguration({
+                    userId: user.Id,
+                    userConfiguration: { ...user.Configuration, EnableLocalPassword: !!pin }
+                }).then(() => undefined);
+            }).then(() => {
+                loading.hide();
+                toast(globalize.translate(pin ? 'EasyPinSaved' : 'EasyPinRemoved'));
+                loadUser().catch(err => {
+                    console.error('[UserPasswordForm] failed to load user', err);
+                });
+            }).catch(err => {
+                loading.hide();
+                console.error('[UserPasswordForm] failed to update easy pin', err);
+                toast(globalize.translate('ErrorDefault'));
+            });
+        };
+
+        const onEasyPinSubmit = (e: Event) => {
+            const pin = (page.querySelector('#txtEasyPin') as HTMLInputElement).value;
+            if (!/^\d{4,8}$/.test(pin)) {
+                toast(globalize.translate('EasyPinInvalid'));
+            } else {
+                setEasyPin(pin);
+            }
+
+            e.preventDefault();
+            return false;
+        };
+
+        const onRemoveEasyPin = () => {
+            confirm(globalize.translate('EasyPinRemoveConfirmation'), globalize.translate('RemoveEasyPinCode')).then(() => {
+                setEasyPin('');
+            }).catch(() => {
+                // confirm dialog was closed
+            });
+        };
+
         (page.querySelector('.updatePasswordForm') as HTMLFormElement).addEventListener('submit', onSubmit);
         (page.querySelector('#btnResetPassword') as HTMLButtonElement).addEventListener('click', resetPassword);
+        (page.querySelector('.updateEasyPinForm') as HTMLFormElement).addEventListener('submit', onEasyPinSubmit);
+        (page.querySelector('#btnRemoveEasyPin') as HTMLButtonElement).addEventListener('click', onRemoveEasyPin);
 
         return () => {
             (page.querySelector('.updatePasswordForm') as HTMLFormElement).removeEventListener('submit', onSubmit);
             (page.querySelector('#btnResetPassword') as HTMLButtonElement).removeEventListener('click', resetPassword);
+            (page.querySelector('.updateEasyPinForm') as HTMLFormElement).removeEventListener('submit', onEasyPinSubmit);
+            (page.querySelector('#btnRemoveEasyPin') as HTMLButtonElement).removeEventListener('click', onRemoveEasyPin);
         };
     }, [api, loadUser, user]);
 

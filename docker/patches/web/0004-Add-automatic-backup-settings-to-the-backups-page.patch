 src/apps/dashboard/routes/backups/index.tsx   |   3 +
 src/strings/en-us.json                        |   4 +
 3 files changed, 145 insertions(+)
 create mode 100644 src/apps/dashboard/features/backups/components/ScheduledBackupSettings.tsx

diff --git a/src/apps/dashboard/features/backups/components/ScheduledBackupSettings.tsx b/src/apps/dashboard/features/backups/components/ScheduledBackupSettings.tsx
new file mode 100644
index 0000000..3f12ba0
--- /dev/null
+++ b/src/apps/dashboard/features/backups/components/ScheduledBackupSettings.tsx
@@ -0,0 +1,138 @@
+import { getSystemApi } from '@jellyfin/sdk/lib/utils/api/system-api';
+import Button from '@mui/material/Button';
+import Checkbox from '@mui/material/Checkbox';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import FormGroup from '@mui/material/FormGroup';
+import Stack from '@mui/material/Stack';
+import TextField from '@mui/material/TextField';
+import Typography from '@mui/material/Typography';
+import Loading from 'components/loading/LoadingComponent';
+import SimpleAlert from 'components/SimpleAlert';
+import { useApi } from 'hooks/useApi';
+import { QUERY_KEY, useNamedConfiguration } from 'hooks/useNamedConfiguration';
+import globalize from 'lib/globalize';
+import React, { useCallback, useEffect, useState } from 'react';
+import { queryClient } from 'utils/query/queryClient';
+
+const CONFIG_KEY = 'scheduledbackup';
+
+interface ScheduledBackupOptions {
+    RetentionCount: number;
+    Database: boolean;
+    Metadata: boolean;
+    Trickplay: boolean;
+    Subtitles: boolean;
+}
+
+const ScheduledBackupSettings = () => {
+    const { api } = useApi();
+    const { data: config, isPending, isError } = useNamedConfiguration<ScheduledBackupOptions>(CONFIG_KEY);
+    const [ options, setOptions ] = useState<ScheduledBackupOptions | null>(null);
+    const [ isSaved, setIsSaved ] = useState(false);
+    const [ isSaveError, setIsSaveError ] = useState(false);
+
+    useEffect(() => {
+        if (config && options === null) {
+            setOptions(config);
+        }
+    }, [ config, options ]);
+
+    const onRetentionChange = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+        const value = parseInt(e.target.value, 10);
+        setOptions(prev => prev && { ...prev, RetentionCount: Number.isNaN(value) ? 0 : value });
+    }, []);
+
+    const onOptionChange = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
+        const { name, checked } = e.target;
+        setOptions(prev => prev && { ...prev, [name]: checked });
+    }, []);
+
+    const onSavedAlertClose = useCallback(() => {
+        setIsSaved(false);
+    }, []);
+
+    const onErrorAlertClose = useCallback(() => {
+        setIsSaveError(false);
+    }, []);
+
+    const onSave = useCallback(() => {
+        if (!api || !options) return;
+
+        getSystemApi(api)
+            .updateNamedConfiguration({ key: CONFIG_KEY, body: options })
+            .then(() => {
+                setIsSaved(true);
+                void queryClient.invalidateQueries({ queryKey: [ QUERY_KEY, CONFIG_KEY ] });
+            })
+            .catch(err => {
+                console.error('[ScheduledBackupSettings] failed to save configuration', err);
+                setIsSaveError(true);
+            });
+    }, [ api, options ]);
+
+    if (isError) {
+        // The settings card is an extra on this page; don't break the page over it
+        return null;
+    }
+
+    if (isPending || !options) {
+        return <Loading />;
+    }
+
+    return (
+        <Stack spacing={2}>
+            <SimpleAlert
+                open={isSaved}
+                title={globalize.translate('Success')}
+                text={globalize.translate('SettingsSaved')}
+                onClose={onSavedAlertClose}
+            />
+            <SimpleAlert
+                open={isSaveError}
+                text={globalize.translate('UnknownError')}
+                onClose={onErrorAlertClose}
+            />
+            <Typography variant='h2'>
+                {globalize.translate('HeaderAutomaticBackups')}
+            </Typography>
+            <Typography>
+                {globalize.translate('AutomaticBackupsHelp')}
+            </Typography>
+            <TextField
+                type='number'
+                label={globalize.translate('LabelBackupRetentionCount')}
+                helperText={globalize.translate('LabelBackupRetentionCountHelp')}
+                value={options.RetentionCount}
+                onChange={onRetentionChange}
+                slotProps={{ htmlInput: { min: 0, step: 1 } }}
+            />
+            <FormGroup>
+                <FormControlLabel
+                    control={<Checkbox name='Database' checked={options.Database} onChange={onOptionChange} />}
+                    label={globalize.translate('LabelDatabase')}
+                />
+                <FormControlLabel
+                    control={<Checkbox name='Metadata' checked={options.Metadata} onChange={onOptionChange} />}
+                    label={globalize.translate('LabelMetadata')}
+                />
+                <FormControlLabel
+                    control={<Checkbox name='Subtitles' checked={options.Subtitles} onChange={onOptionChange} />}
+                    label={globalize.translate('Subtitles')}
+                />
+                <FormControlLabel
+                    control={<Checkbox name='Trickplay' checked={options.Trickplay} onChange={onOptionChange} />}
+                    label={globalize.translate('Trickplay')}
+                />
+            </FormGroup>
+            <Button
+                variant='contained'
+                onClick={onSave}
+                sx={{ alignSelf: 'flex-start' }}
+            >
+                {globalize.translate('Save')}
+            </Button>
+        </Stack>
+    );
+};
+
+export default ScheduledBackupSettings;

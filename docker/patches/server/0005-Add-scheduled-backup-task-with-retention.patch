diff --git a/Emby.Server.Implementations/ScheduledTasks/Tasks/BackupTask.cs b/Emby.Server.Implementations/ScheduledTasks/Tasks/BackupTask.cs
new file mode 100644
index 0000000..3b4dd15
--- /dev/null
+++ b/Emby.Server.Implementations/ScheduledTasks/Tasks/BackupTask.cs
@@ -0,0 +1,119 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Server.Implementations.SystemBackupService;
+using MediaBrowser.Common.Configuration;
+using MediaBrowser.Controller.SystemBackupService;
+using MediaBrowser.Model.Configuration;
+using MediaBrowser.Model.Globalization;
+using MediaBrowser.Model.Tasks;
+using Microsoft.Extensions.Logging;
+
+namespace Emby.Server.Implementations.ScheduledTasks.Tasks;
+
+/// <summary>
+/// Creates a backup of the server configuration on a schedule and prunes old
+/// backups beyond the configured retention count.
+/// </summary>
+public class BackupTask : IScheduledTask, IConfigurableScheduledTask
+{
+    private readonly ILogger<BackupTask> _logger;
+    private readonly ILocalizationManager _localization;
+    private readonly IBackupService _backupService;
+    private readonly IConfigurationManager _configurationManager;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="BackupTask" /> class.
+    /// </summary>
+    /// <param name="logger">Instance of the <see cref="ILogger"/> interface.</param>
+    /// <param name="localization">Instance of the <see cref="ILocalizationManager"/> interface.</param>
+    /// <param name="backupService">Instance of the <see cref="IBackupService"/> interface.</param>
+    /// <param name="configurationManager">Instance of the <see cref="IConfigurationManager"/> interface.</param>
+    public BackupTask(
+        ILogger<BackupTask> logger,
+        ILocalizationManager localization,
+        IBackupService backupService,
+        IConfigurationManager configurationManager)
+    {
+        _logger = logger;
+        _localization = localization;
+        _backupService = backupService;
+        _configurationManager = configurationManager;
+    }
+
+    /// <inheritdoc />
+    public string Name => _localization.GetLocalizedString("TaskBackup");
+
+    /// <inheritdoc />
+    public string Description => _localization.GetLocalizedString("TaskBackupDescription");
+
+    /// <inheritdoc />
+    public string Category => _localization.GetLocalizedString("TasksMaintenanceCategory");
+
+    /// <inheritdoc />
+    public string Key => "ScheduledBackup";
+
+    /// <inheritdoc />
+    public bool IsHidden => false;
+
+    /// <inheritdoc />
+    public bool IsEnabled => true;
+
+    /// <inheritdoc />
+    public bool IsLogged => true;
+
+    /// <inheritdoc />
+    public IEnumerable<TaskTriggerInfo> GetDefaultTriggers()
+    {
+        yield return new TaskTriggerInfo
+        {
+            Type = TaskTriggerInfoType.DailyTrigger,
+            TimeOfDayTicks = TimeSpan.FromHours(3).Ticks
+        };
+    }
+
+    /// <inheritdoc />
+    public async Task ExecuteAsync(IProgress<double> progress, CancellationToken cancellationToken)
+    {
+        var options = _configurationManager.GetConfiguration<ScheduledBackupOptions>("scheduledbackup");
+
+        var manifest = await _backupService.CreateBackupAsync(new BackupOptionsDto
+        {
+            Database = options.Database,
+            Metadata = options.Metadata,
+            Trickplay = options.Trickplay,
+            Subtitles = options.Subtitles
+        }).ConfigureAwait(false);
+
+        _logger.LogInformation("Scheduled backup created at {Path}", manifest.Path);
+        progress.Report(70);
+
+        if (options.RetentionCount > 0)
+        {
+            var backups = await _backupService.EnumerateBackups().ConfigureAwait(false);
+            var expired = backups
+                .OrderByDescending(b => b.DateCreated)
+                .Skip(options.RetentionCount);
+
+            foreach (var backup in expired)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+
+                try
+                {
+                    File.Delete(backup.Path);
+                    _logger.LogInformation("Deleted expired backup {Path} from {Date}", backup.Path, backup.DateCreated);
+                }
+                catch (Exception ex)
+                {
+                    _logger.LogError(ex, "Failed to delete expired backup {Path}", backup.Path);
+                }
+            }
+        }
+
+        progress.Report(100);
+    }
+}
diff --git a/MediaBrowser.Model/Configuration/ScheduledBackupOptions.cs b/MediaBrowser.Model/Configuration/ScheduledBackupOptions.cs
new file mode 100644
index 0000000..7505adf
--- /dev/null
+++ b/MediaBrowser.Model/Configuration/ScheduledBackupOptions.cs
@@ -0,0 +1,35 @@
+namespace MediaBrowser.Model.Configuration
+{
+    /// <summary>
+    /// Options controlling the scheduled backup task.
+    /// </summary>
+    public class ScheduledBackupOptions
+    {
+        /// <summary>
+        /// Gets or sets the number of backups to keep in the backup folder.
+        /// When the scheduled backup task runs, the oldest backups beyond this
+        /// count are deleted. Zero or a negative value keeps all backups.
+        /// </summary>
+        public int RetentionCount { get; set; } = 3;
+
+        /// <summary>
+        /// Gets or sets a value indicating whether the database is included in scheduled backups.
+        /// </summary>
+        public bool Database { get; set; } = true;
+
+        /// <summary>
+        /// Gets or sets a value indicating whether metadata is included in scheduled backups.
+        /// </summary>
+        public bool Metadata { get; set; }
+
+        /// <summary>
+        /// Gets or sets a value indicating whether trickplay images are included in scheduled backups.
+        /// </summary>
+        public bool Trickplay { get; set; }
+
+        /// <summary>
+        /// Gets or sets a value indicating whether subtitles are included in scheduled backups.
+        /// </summary>
+        public bool Subtitles { get; set; }
+    }
+}

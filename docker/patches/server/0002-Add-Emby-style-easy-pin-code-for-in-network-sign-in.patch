+namespace Jellyfin.Api.Models.UserDtos;
+
+/// <summary>
+/// The update user easy password request body.
+/// </summary>
+public class UpdateUserEasyPassword
+{
+    /// <summary>
+    /// Gets or sets the new plain text pin code.
+    /// </summary>
+    public string? NewPw { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether to reset the pin code.
+    /// </summary>
+    public bool ResetPassword { get; set; }
+}
diff --git a/Jellyfin.Server.Implementations/Users/DefaultAuthenticationProvider.cs b/Jellyfin.Server.Implementations/Users/DefaultAuthenticationProvider.cs
index 446849b..cecef36 100644
--- a/Jellyfin.Server.Implementations/Users/DefaultAuthenticationProvider.cs
+++ b/Jellyfin.Server.Implementations/Users/DefaultAuthenticationProvider.cs
@@ -107,5 +107,40 @@ namespace Jellyfin.Server.Implementations.Users
 
             return Task.CompletedTask;
         }
+
+        /// <summary>
+        /// Changes the user's easy pin code used for in-network sign-in, clearing it when empty.
+        /// </summary>
+        /// <param name="user">The user.</param>
+        /// <param name="newPassword">The new pin code, or empty to clear it.</param>
+        /// <returns>A task representing the operation.</returns>
+        public Task ChangeEasyPassword(User user, string newPassword)
+        {
+            if (string.IsNullOrEmpty(newPassword))
+            {
+                user.EasyPassword = null;
+                return Task.CompletedTask;
+            }
+
+            user.EasyPassword = _cryptographyProvider.CreatePasswordHash(newPassword).ToString();
+
+            return Task.CompletedTask;
+        }
+
+        /// <summary>
+        /// Verifies a value against the user's easy pin code.
+        /// </summary>
+        /// <param name="user">The user.</param>
+        /// <param name="password">The value to verify.</param>
+        /// <returns><c>true</c> if the value matches the user's pin code.</returns>
+        public bool VerifyEasyPassword(User user, string password)
+        {
+            if (string.IsNullOrEmpty(user.EasyPassword) || string.IsNullOrEmpty(password))
+            {
+                return false;
+            }
+
+            return _cryptographyProvider.Verify(PasswordHash.Parse(user.EasyPassword), password);
+        }
     }
 }

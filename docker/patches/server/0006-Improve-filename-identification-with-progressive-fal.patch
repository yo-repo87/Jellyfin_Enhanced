+        /// <summary>
+        /// Generates the name and year combinations to try for a text search, from most to
+        /// least specific. The first attempt is the name and year as given. When a search
+        /// returns nothing, later attempts drop the year (it may simply be wrong) and then
+        /// progressively drop trailing words, because release tags that survive filename
+        /// cleaning end up as extra words at the end of the parsed name.
+        /// </summary>
+        /// <param name="cleanedName">The search name, already cleaned with <see cref="CleanName"/>.</param>
+        /// <param name="year">The year to search with, or 0 when unknown.</param>
+        /// <returns>The (name, year) attempts, most specific first.</returns>
+        public static IEnumerable<(string Name, int Year)> GetSearchAttempts(string cleanedName, int year)
+        {
+            yield return (cleanedName, year);
+            if (year > 0)
+            {
+                yield return (cleanedName, 0);
+            }
+
+            var current = cleanedName;
+            for (var i = 0; i < 3; i++)
+            {
+                var cut = current.LastIndexOf(' ');
+                if (cut < 3)
+                {
+                    break;
+                }
+
+                current = current[..cut].TrimEnd();
+                yield return (current, year);
+                if (year > 0)
+                {
+                    yield return (current, 0);
+                }
+            }
+        }
+
         /// <summary>
         /// Reduces a title to the form used to compare a local name against a TMDb search result.
         /// </summary>

diff --git a/MediaBrowser.Controller/Library/IVideoVersionManager.cs b/MediaBrowser.Controller/Library/IVideoVersionManager.cs
new file mode 100644
index 0000000..835432d
--- /dev/null
+++ b/MediaBrowser.Controller/Library/IVideoVersionManager.cs
@@ -0,0 +1,21 @@
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+using MediaBrowser.Controller.Entities;
+
+namespace MediaBrowser.Controller.Library
+{
+    /// <summary>
+    /// Service for linking videos together as alternate versions of one item.
+    /// </summary>
+    public interface IVideoVersionManager
+    {
+        /// <summary>
+        /// Merges the given videos into a single record with multiple versions.
+        /// </summary>
+        /// <param name="items">The videos to merge. Requires at least two items; the primary version is selected automatically.</param>
+        /// <param name="cancellationToken">The cancellation token.</param>
+        /// <returns>A task representing the merge operation.</returns>
+        Task MergeVersionsAsync(IReadOnlyList<Video> items, CancellationToken cancellationToken);
+    }
+}

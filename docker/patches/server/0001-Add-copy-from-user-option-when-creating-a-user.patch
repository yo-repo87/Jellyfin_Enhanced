From 8a2e6421a7acd989b36128f094254654b5a0cbc3 Mon Sep 17 00:00:00 2001
From: Matthew Gibson <matthew.gibson041387@gmail.com>
Date: Wed, 11 Nov 2026 15:54:41 +0000
Subject: [PATCH 1/7] Add copy-from-user option when creating a user

Port of Emby's 'copy settings from existing user' feature: POST /Users/New
accepts an optional CopyFromUserId whose policy and configuration are
applied to the newly created user.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 Jellyfin.Api/Controllers/UserController.cs       | 15 +++++++++++++++
 Jellyfin.Api/Models/UserDtos/CreateUserByName.cs |  7 +++++++
 2 files changed, 22 insertions(+)

diff --git a/Jellyfin.Api/Controllers/UserController.cs b/Jellyfin.Api/Controllers/UserController.cs
index 657bda4..5b46ae4 100644
--- a/Jellyfin.Api/Controllers/UserController.cs
+++ b/Jellyfin.Api/Controllers/UserController.cs
@@ -519,6 +519,14 @@ public class UserController : BaseJellyfinApiController
     [ProducesResponseType(StatusCodes.Status200OK)]
     public async Task<ActionResult<UserDto>> CreateUserByName([FromBody, Required] CreateUserByName request)
     {
+        var sourceUser = request.CopyFromUserId.HasValue
+            ? _userManager.GetUserById(request.CopyFromUserId.Value)
+            : null;
+        if (request.CopyFromUserId.HasValue && sourceUser is null)
+        {
+            return BadRequest("The user to copy settings from does not exist.");
+        }
+
         var newUser = await _userManager.CreateUserAsync(request.Name).ConfigureAwait(false);
 
         // no need to authenticate password for new user
@@ -527,6 +535,13 @@ public class UserController : BaseJellyfinApiController
             await _userManager.ChangePassword(newUser.Id, request.Password).ConfigureAwait(false);
         }
 
+        if (sourceUser is not null)
+        {
+            var sourceDto = _userManager.GetUserDto(sourceUser);
+            await _userManager.UpdatePolicyAsync(newUser.Id, sourceDto.Policy).ConfigureAwait(false);
+            await _userManager.UpdateConfigurationAsync(newUser.Id, sourceDto.Configuration).ConfigureAwait(false);
+        }
+
         var result = _userManager.GetUserDto(newUser, HttpContext.GetNormalizedRemoteIP().ToString());
 
         return result;
diff --git a/Jellyfin.Api/Models/UserDtos/CreateUserByName.cs b/Jellyfin.Api/Models/UserDtos/CreateUserByName.cs
index 484a0f1..c49dac5 100644
--- a/Jellyfin.Api/Models/UserDtos/CreateUserByName.cs
+++ b/Jellyfin.Api/Models/UserDtos/CreateUserByName.cs
@@ -1,3 +1,4 @@
+using System;
 using System.ComponentModel.DataAnnotations;
 
 namespace Jellyfin.Api.Models.UserDtos;
@@ -17,4 +18,10 @@ public class CreateUserByName
     /// Gets or sets the password.
     /// </summary>
     public string? Password { get; set; }
+
+    /// <summary>
+    /// Gets or sets the id of an existing user whose policy and configuration
+    /// are copied onto the new user.
+    /// </summary>
+    public Guid? CopyFromUserId { get; set; }
 }
-- 
